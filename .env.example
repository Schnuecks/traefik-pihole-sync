# Copy to .env and adjust. Only PIHOLE_URL and TARGET_IP (or CNAME_TARGET) are required.

# --- Traefik ---------------------------------------------------------------
TRAEFIK_API_URL=http://traefik:8080
# Also read TCP routers with HostSNI() rules
TRAEFIK_TCP_ROUTERS=false

# --- Pi-hole ---------------------------------------------------------------
# One or more Pi-hole v6 instances, comma-separated
PIHOLE_URL=http://pihole.example.internal
# Prefer a file (Docker secret). One file for all instances or one per instance.
PIHOLE_PASSWORD_FILE=/run/secrets/pihole_password
# PIHOLE_PASSWORD=
# true, false or the path of a CA bundle (e.g. /certs/ca.pem)
PIHOLE_VERIFY_TLS=true

# --- Records ---------------------------------------------------------------
# A: every hostname gets an A (and AAAA) record
# CNAME: every hostname becomes a CNAME to CNAME_TARGET
RECORD_TYPE=A
TARGET_IP=192.0.2.10
# TARGET_IPV6=2001:db8::10
# CNAME_TARGET=proxy.example.com

# Only sync hostnames inside these domains (comma-separated). Empty = all.
DOMAINS=example.com
# Also add a record for each domain in DOMAINS that has at least one hostname
INCLUDE_APEX=false

# --- Behaviour -------------------------------------------------------------
SYNC_INTERVAL=60
# Delete a record only after it was missing from Traefik this many cycles in a row
DELETE_THRESHOLD=3
DRY_RUN=false
LOG_LEVEL=INFO
